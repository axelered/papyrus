{
  "name": "@axelered/papyrus",
  "version": "0.0.0",
  "description": "TypeScript client for Papyrus, the self-hosted document processing API",
  "license": "Apache-2.0",
  "author": {
    "name": "Axelered",
    "email": "oss@axelered.com",
    "url": "https://axelered.com"
  },
  "homepage": "https://docs.axelered.com/papyrus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axelered/papyrus.git",
    "directory": "sdk/typescript"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc && biome check --error-on-warnings .",
    "format": "biome check --write .",
    "test:node": "node --test 'test/*.test.ts'",
    "test:bun": "bun test ./test",
    "test:all": "bun run check && bun run test:node && bun run test:bun",
    "prepack": "bun run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/node": "^22",
    "typescript": "^7.0.2"
  }
}
